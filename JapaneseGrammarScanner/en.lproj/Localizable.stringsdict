<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%lld 个没看过</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld not viewed</string>
			<key>other</key>
			<string>%lld not viewed</string>
		</dict>
	</dict>
	<key>%lld 次扫描</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>in %lld scan</string>
			<key>other</key>
			<string>in %lld scans</string>
		</dict>
	</dict>
	<key>免费试用中，还剩 %lld 天</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Free trial: %lld day left</string>
			<key>other</key>
			<string>Free trial: %lld days left</string>
		</dict>
	</dict>
	<key>免费试用还剩 %lld 天</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld day left in your free trial</string>
			<key>other</key>
			<string>%lld days left in your free trial</string>
		</dict>
	</dict>
	<key>出现 %lld 次</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld time</string>
			<key>other</key>
			<string>%lld times</string>
		</dict>
	</dict>
	<key>前 %lld 天免费使用全部功能。之后可一次性购买，永久解锁完整讲解；不是订阅，不会自动扣费。购买在同一 Apple ID 的设备间通用，可以在「设置 → 购买」中恢复。</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>All features are free for the first %lld day. After that, you can make a one-time purchase to unlock full explanations forever. It's not a subscription and you won't be charged automatically. The purchase works on all devices using the same Apple ID and can be restored in “Settings → Purchase”.</string>
			<key>other</key>
			<string>All features are free for the first %lld days. After that, you can make a one-time purchase to unlock full explanations forever. It's not a subscription and you won't be charged automatically. The purchase works on all devices using the same Apple ID and can be restored in “Settings → Purchase”.</string>
		</dict>
	</dict>
	<key>有 %lld 个快要忘了</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld grammar point fading</string>
			<key>other</key>
			<string>%lld grammar points fading</string>
		</dict>
	</dict>
