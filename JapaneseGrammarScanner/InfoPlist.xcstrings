            "value": "Gramática JP"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문법 스캔"
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "သဒ္ဒါစကင်"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngữ Pháp JP"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语法扫描"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "語法掃描"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera is used to scan Japanese text in books and identify grammar points. Images are processed on your device only."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cámara se usa para escanear texto japonés de libros e identificar puntos gramaticales. Las imágenes se procesan solo en tu dispositivo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "책의 일본어를 스캔해 문법을 인식하기 위해 카메라를 사용합니다. 이미지는 기기 안에서만 처리됩니다."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "စာအုပ်ထဲရှိ ဂျပန်စာကို စကင်ဖတ်ပြီး သဒ္ဒါများကို ရှာဖွေရန် ကင်မရာကို အသုံးပြုပါသည်။ ပုံများကို သင့်စက်ပေါ်တွင်သာ လုပ်ဆောင်ပါသည်။"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng dùng camera để quét chữ tiếng Nhật trong sách và nhận diện ngữ pháp. Hình ảnh chỉ được xử lý trên thiết bị."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要使用相机扫描书本上的日文，以识别其中的语法点。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要使用相機掃描書本上的日文，以識別其中的語法點。"
          }
        }
      }
    }
  },
  "version": "1.0"
}