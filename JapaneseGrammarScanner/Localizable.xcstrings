    "在语法讲解页或列表中点击 ☆ 即可收藏。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap ☆ on a grammar page or in a list to save it here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca ☆ en una explicación o en la lista para guardarla aquí."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문법 설명 화면이나 목록에서 ☆를 누르면 즐겨찾기에 추가됩니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn ☆ trong trang giải thích hoặc danh sách để lưu vào đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在语法讲解页或列表中点击 ☆ 即可收藏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在語法講解頁或列表中點選 ☆ 即可收藏。"
          }
        }
      }
    },
