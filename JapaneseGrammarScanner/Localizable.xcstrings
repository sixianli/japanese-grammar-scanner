    "点击图片或文本中的高亮，或下方列表，查看详细讲解。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a highlight in the image or text, or an item below, to see the explanation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un resaltado en la imagen o el texto, o un elemento de la lista, para ver la explicación."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지나 텍스트의 하이라이트, 또는 아래 목록을 눌러 자세한 설명을 보세요."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn vào phần tô sáng trong ảnh, văn bản hoặc danh sách bên dưới để xem giải thích."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击图片或文本中的高亮，或下方列表，查看详细讲解。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
