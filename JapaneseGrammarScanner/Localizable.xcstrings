        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "အဓိပ္ပာယ်အလိုက် အသုံးပြုပုံ၊ တွဲဆက်ပုံနှင့် ဥပမာများ"
          }
        },
        "vi": {
