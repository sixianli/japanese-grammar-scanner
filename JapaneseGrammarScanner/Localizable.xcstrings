        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공개된 시험 복원 자료와 교재를 바탕으로 정리한 참고용 정보입니다."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "အများသိ စာမေးပွဲ ပြန်လည်မှတ်တမ်းများနှင့် ဖတ်စာအုပ်များမှ စုစည်းထားခြင်း ဖြစ်ပါသည်။ ကိုးကားရန်သာ ဖြစ်ပါသည်။"
