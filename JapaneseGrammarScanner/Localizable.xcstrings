    "点击图片或文本中的高亮，或下方列表，查看详细讲解。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a highlight in the image or text, or an item below, to see the explanation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un resaltado en la imagen o el texto, o un elemento de la lista, para ver la explicación."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지나 텍스트의 하이라이트, 또는 아래 목록을 눌러 자세한 설명을 보세요."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ရှင်းလင်းချက် ကြည့်ရန် ပုံ သို့မဟုတ် စာသားထဲရှိ အရောင်ခြယ်ထားသည်ကို၊ သို့မဟုတ် အောက်ပါစာရင်းကို နှိပ်ပါ။"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn vào phần tô sáng trong ảnh, văn bản hoặc danh sách bên dưới để xem giải thích."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击图片或文本中的高亮，或下方列表，查看详细讲解。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點選圖片或文字中的高亮，或下方列表，檢視詳細講解。"
          }
        }
      }
    },
    "点击高亮或下方列表查看讲解；点击图片可放大查看原文。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a highlight or an item below for the explanation. Tap the photo to zoom in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un resaltado o un elemento para ver la explicación. Toca la foto para ampliarla."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하이라이트나 아래 목록을 눌러 설명을 보세요. 사진을 누르면 확대할 수 있습니다."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ရှင်းလင်းချက် ကြည့်ရန် အရောင်ခြယ်ထားသည် သို့မဟုတ် အောက်ပါစာရင်းကို နှိပ်ပါ။ ပုံကို နှိပ်၍ ချဲ့ကြည့်နိုင်သည်။"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn vào phần tô sáng hoặc danh sách để xem giải thích. Nhấn vào ảnh để phóng to."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击高亮或下方列表查看讲解；点击图片可放大查看原文。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點選高亮或下方列表檢視講解；點選圖片可放大檢視原文。"
          }
        }
      }
    },
