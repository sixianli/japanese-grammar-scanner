    "会自动附上 App 版本、系统版本、设备型号和语言，方便定位问题。不会附带其他个人信息。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app version, iOS version, device model and language are added automatically to help us find the problem. No other personal information is included."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se añaden automáticamente la versión de la app, la de iOS, el modelo del dispositivo y el idioma. No se incluye otra información personal."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문제 파악을 위해 앱 버전, iOS 버전, 기기 모델, 언어가 자동으로 첨부됩니다. 다른 개인정보는 포함되지 않습니다."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ပြဿနာရှာရန် App ဗားရှင်း၊ iOS ဗားရှင်း၊ စက်မော်ဒယ်နှင့် ဘာသာစကားကို အလိုအလျောက် ထည့်ပေးမည်။ အခြား ကိုယ်ရေးအချက်အလက် မပါပါ။"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiên bản ứng dụng, phiên bản iOS, mẫu thiết bị và ngôn ngữ sẽ được tự động đính kèm. Không kèm thông tin cá nhân nào khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会自动附上 App 版本、系统版本、设备型号和语言，方便定位问题。不会附带其他个人信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "會自動附上 App 版本、系統版本、裝置型號和語言，方便定位問題。不會附帶其他個人資訊。"
          }
        }
      }
    },
