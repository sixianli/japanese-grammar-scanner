    "一次性 %@ 永久解锁，不订阅": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock forever for a one-time %@. No subscription."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloqueo para siempre por un pago único de %@. Sin suscripción."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 한 번 구매로 영구 잠금 해제 · 구독 없음"
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ဖြင့် တစ်ကြိမ်ဝယ်ပြီး အမြဲတမ်း ဖွင့်ပါ။ လစဉ်ကြေး မရှိပါ။"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mua một lần %@ để mở khóa vĩnh viễn, không đăng ký"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次性 %@ 永久解锁，不订阅"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一次性 %@ 永久解鎖，不訂閱"
          }
        }
      }
    },
